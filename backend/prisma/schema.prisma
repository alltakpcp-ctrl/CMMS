generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums nativos do Postgres não são usados de propósito (decisão de produção,
// §2 do CLAUDE.md): os valores permitidos (Role, Sector, WorkOrderType,
// WorkOrderStatus, Priority) continuam validados na aplicação via
// src/domain/enums.ts e src/modules/*/schema.ts (zod), para manter o schema
// idêntico entre dev e produção e a lógica de validação centralizada.

model User {
  id                     String   @id @default(cuid())
  name                   String
  email                  String   @unique
  passwordHash           String
  role                   String
  sectorId               String?
  sector                 Sector?  @relation(fields: [sectorId], references: [id])
  canReceivePartRequests Boolean  @default(false)
  canManageStock         Boolean  @default(false)
  canPurchase            Boolean  @default(false)
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  shiftId                String?
  shift                  Shift?   @relation(fields: [shiftId], references: [id])

  workOrdersRequested             WorkOrder[]                   @relation("WorkOrderRequester")
  workOrdersAssigned              WorkOrder[]                   @relation("WorkOrderAssignee")
  workOrdersPriorityAdjusted      WorkOrder[]                   @relation("WorkOrderPriorityAdjustedBy")
  statusChanges                   StatusHistory[]
  partRequestsCreated             PartRequest[]                 @relation("partRequestsCreated")
  purchaseOrdersCreated           PurchaseOrder[]               @relation("purchaseOrdersCreated")
  purchaseOrdersReviewed          PurchaseOrder[]               @relation("purchaseOrdersReviewed")
  assigneeOf                      WorkOrderAssignee[]
  executionLogs                   ExecutionLog[]
  stockMovements                  StockMovement[]
  subtasksCreated                 Subtask[]                     @relation("SubtaskCreatedBy")
  subtasksAssigned                Subtask[]                     @relation("SubtaskAssignedTo")
  subtasksClosedBy                Subtask[]                     @relation("SubtaskClosedBy")
  purchaseOrderComments           PurchaseOrderComment[]        @relation("purchaseOrderComments")
  stockWithdrawalRequestsCreated  StockWithdrawalRequest[]      @relation("stockWithdrawalRequestsCreated")
  stockWithdrawalRequestsReviewed StockWithdrawalRequest[]      @relation("stockWithdrawalRequestsReviewed")
  permissoesTrabalhoAprovadas     PermissaoTrabalho[]           @relation("PermissaoTrabalhoApprovedBy")
  assinaturasPT                   PermissaoTrabalhoAssinatura[] @relation("PermissaoTrabalhoAssinaturaUser")
  assinaturasPTSolicitadas        PermissaoTrabalhoAssinatura[] @relation("PermissaoTrabalhoAssinaturaRequestedBy")
  executionsStarted               Execution[]                   @relation("ExecutionStartedBy")
  executionsEnded                 Execution[]                   @relation("ExecutionEndedBy")
  workOrdersExcluded              WorkOrder[]                   @relation("WorkOrderExcludedBy")
  maintenancePlansExcluded        MaintenancePlan[]             @relation("MaintenancePlanExcludedBy")
}

model Shift {
  id        String   @id @default(cuid())
  name      String   @unique
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users User[]
}

model Sector {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets       Asset[]
  assetSectors AssetSector[]
  workOrders   WorkOrder[]
  users        User[]
  parts        Part[]
}

model Asset {
  id                        String   @id @default(cuid())
  code                      String   @unique
  name                      String
  // @deprecated setor primário; visibilidade real via AssetSector (N:N)
  sectorId                  String
  // @deprecated setor primário; visibilidade real via AssetSector (N:N)
  sector                    Sector   @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  location                  String
  criticality               Int
  // GANCHO FUTURO (§5.6): campo já existe para uma futura geração automática
  // de OS PREVENTIVA — um job agendado (cron) verificaria, por ativo, se
  // `hoje - data da última preventiva encerrada >= preventivePeriodicityDays`
  // e chamaria a mesma lógica de `workorders/service.ts#createWorkOrder`.
  // NÃO implementado no MVP (abertura de preventiva é sempre manual).
  preventivePeriodicityDays Int?
  active                    Boolean  @default(true)
  createdAt                 DateTime @default(now())

  workOrders       WorkOrder[]
  sectors          AssetSector[]
  partRequests     PartRequest[]
  maintenancePlans MaintenancePlan[]
}

model AssetSector {
  assetId   String
  sectorId  String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sector    Sector   @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([assetId, sectorId])
}

model Part {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  unit        String
  stockQty    Int      @default(0)
  createdAt   DateTime @default(now())

  minStock            Int?
  maxStock            Int?
  unitCost            Decimal? @db.Decimal(12, 2)
  location            String?
  sectorId            String?
  sector              Sector?  @relation(fields: [sectorId], references: [id])
  active              Boolean  @default(true)
  stockStatusOverride String?
  updatedAt           DateTime @default(now()) @updatedAt

  workOrderParts              WorkOrderPart[]
  partRequests                PartRequest[]
  plannedPartItems            WorkOrderPlannedPart[]
  stockMovements              StockMovement[]
  stockWithdrawalRequestItems StockWithdrawalRequestItem[]
}

model WorkOrder {
  id                     String           @id @default(cuid())
  number                 String           @unique
  type                   String
  disciplina             String           @default("ELETRICA")
  trabalhoEmAltura       Boolean          @default(false)
  status                 String           @default("ABERTA")
  priority               String
  title                  String
  description            String
  requesterId            String
  requester              User             @relation("WorkOrderRequester", fields: [requesterId], references: [id])
  assetId                String
  asset                  Asset            @relation(fields: [assetId], references: [id])
  targetSectorId         String?
  targetSector           Sector?          @relation(fields: [targetSectorId], references: [id], onDelete: Restrict)
  plan                   String?
  // @deprecated como input — agora derivado de assignees.count + 1 (responsável
  // principal + manutentores de apoio). Mantido como coluna para não quebrar
  // dados existentes; não deve mais ser aceito diretamente pela API.
  numMaintainers         Int?
  estimatedHours         Decimal?         @db.Decimal(5, 2)
  safetyEquipment        String? // @deprecated usar ppe
  plannedParts           Json? // @deprecated usar plannedPartItems
  tools                  Json?
  ppe                    Json?
  scheduledStart         DateTime?
  scheduledEnd           DateTime?
  assignedToId           String?
  assignedTo             User?            @relation("WorkOrderAssignee", fields: [assignedToId], references: [id])
  maintenancePlanId      String?
  maintenancePlan        MaintenancePlan? @relation(fields: [maintenancePlanId], references: [id])
  priorityAdjustedByTech Boolean          @default(false)
  priorityOriginal       String?
  priorityAdjustedAt     DateTime?
  priorityAdjustedById   String?
  priorityAdjustedBy     User?            @relation("WorkOrderPriorityAdjustedBy", fields: [priorityAdjustedById], references: [id])
  // Exclusão lógica (Fase 1 do "baú de cancelados/excluídos", ver CLAUDE.md §5.2):
  // só aplicável a OS em ABERTA (nunca saiu da fase inicial); OS que já andou
  // e precisa ser interrompida usa cancelar() (CANCELADA), não isto. Uma OS
  // excluída não é removida fisicamente — some das telas operacionais e dos
  // indicadores, mas continua íntegra no banco e visível no Baú (SUPERVISOR).
  excludedAt             DateTime?
  excludedById           String?
  excludedBy             User?            @relation("WorkOrderExcludedBy", fields: [excludedById], references: [id])
  exclusionReason        String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  executions              Execution[]
  parts                   WorkOrderPart[]
  statusHistory           StatusHistory[]
  partRequests            PartRequest[]
  plannedPartItems        WorkOrderPlannedPart[]
  assignees               WorkOrderAssignee[]
  stockMovements          StockMovement[]
  stockWithdrawalRequests StockWithdrawalRequest[]
  subtasks                Subtask[]
  permissaoTrabalho       PermissaoTrabalho?
}

// Manutentores de apoio (N:N), distintos do responsável principal
// (WorkOrder.assignedToId). Preenchida em planejamento()/iniciar() —
// numMaintainers passa a ser derivado de assignees.count + 1.
model WorkOrderAssignee {
  id          String    @id @default(cuid())
  workOrderId String
  userId      String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([workOrderId, userId])
  @@index([workOrderId])
  @@index([userId])
}

// Plano de manutenção preventiva — 1 registro por item de checklist. Vencimento
// é calculado sob demanda (sem cron) em lib/maintenancePlans.ts, a partir da
// última Execution encerrada vinculada a uma WorkOrder deste plano (ou de
// createdAt, se nunca executado). Criar um plano gera a 1ª OS na hora, já
// PROGRAMADA (ver maintenance-plans/service.ts); ciclos seguintes usam
// POST /maintenance-plans/:id/gerar-os quando o plano vence de novo.
// periodicity é opcional para suportar o plano "rascunho" criado quando um
// OPERADOR abre uma OS PREVENTIVA sem que exista plano prévio para o ativo —
// nesse caso não há periodicidade conhecida ainda (supervisor completa depois).
model MaintenancePlan {
  id              String    @id @default(cuid())
  assetId         String
  asset           Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  discipline      String // MaintenanceDiscipline
  title           String
  description     String?
  priority        String // Priority
  periodicity     String? // MaintenancePeriodicity — null = plano rascunho, sem periodicidade definida
  estimatedHours  Decimal?  @db.Decimal(5, 2)
  responsible     String?
  action01        String?
  action02        String?
  action03        String?
  action04        String?
  action05        String?
  action06        String?
  active          Boolean   @default(true)
  // Exclusão lógica em cascata: quando a OS que originou este plano rascunho
  // (periodicity null) é excluída e nenhuma outra OS está vinculada a ele, o
  // plano é marcado excluído junto — mesma semântica de WorkOrder.excludedAt.
  excludedAt      DateTime?
  excludedById    String?
  excludedBy      User?     @relation("MaintenancePlanExcludedBy", fields: [excludedById], references: [id])
  exclusionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workOrders WorkOrder[]

  @@index([assetId])
}

// status é String validada via zod (ABERTA | CONCLUIDA | CANCELADA), mesma
// decisão de §2 do CLAUDE.md aplicada aos demais campos do schema. Ortogonal
// a Execution: subtarefas registram partes concluídas do trabalho dentro de
// uma OS, sem relação com o ciclo de execução/registro de reparo.
model Subtask {
  id             String    @id @default(cuid())
  workOrderId    String
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  status         String    @default("ABERTA")
  estimatedHours Decimal   @db.Decimal(5, 2)
  createdById    String
  createdBy      User      @relation("SubtaskCreatedBy", fields: [createdById], references: [id])
  assignedToId   String
  assignedTo     User      @relation("SubtaskAssignedTo", fields: [assignedToId], references: [id])
  // @deprecated ver openedAt/closedAt abaixo — mantido para não quebrar dados
  // existentes; só é preenchido no caminho CONCLUIDA (não em CANCELADA).
  finishedAt     DateTime?
  // Timestamp imutável de abertura (sempre now() do servidor, nunca editável).
  openedAt       DateTime  @default(now())
  // Preenchido tanto em CONCLUIDA quanto em CANCELADA (now() do servidor).
  closedAt       DateTime?
  closedById     String?
  closedBy       User?     @relation("SubtaskClosedBy", fields: [closedById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  stockWithdrawalRequests StockWithdrawalRequest[]

  @@index([workOrderId])
  @@index([assignedToId])
}

model Execution {
  id                String    @id @default(cuid())
  workOrderId       String
  workOrder         WorkOrder @relation(fields: [workOrderId], references: [id])
  riskAnalysis      String?
  // @deprecated registro legado (pré-ExecutionLog) — mantido como primeira
  // entrada histórica exibida na UI; novos registros vão para `logs`.
  rootCause         String?
  // @deprecated ver rootCause acima.
  repairDescription String?
  startedAt         DateTime?
  finishedAt        DateTime?
  testNotes         String?
  cleanupDone       Boolean   @default(false)
  startedById       String?
  startedBy         User?     @relation("ExecutionStartedBy", fields: [startedById], references: [id])
  endedById         String?
  endedBy           User?     @relation("ExecutionEndedBy", fields: [endedById], references: [id])
  startNote         String?
  endNote           String?
  outcome           String?

  logs ExecutionLog[]

  @@index([workOrderId])
}

// Histórico de registros de execução (causa raiz + reparo) dentro de um
// mesmo ciclo de Execution — cada chamada a registrar() cria uma entrada
// nova em vez de sobrescrever Execution.rootCause/repairDescription.
model ExecutionLog {
  id          String    @id @default(cuid())
  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  note        String
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([executionId])
}

model WorkOrderPart {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  partId      String
  part        Part      @relation(fields: [partId], references: [id])
  quantity    Int
}

model StockMovement {
  id                  String                  @id @default(cuid())
  partId              String
  part                Part                    @relation(fields: [partId], references: [id])
  type                String
  quantity            Int
  balanceAfter        Int
  unitCost            Decimal?                @db.Decimal(12, 2)
  workOrderId         String?
  workOrder           WorkOrder?              @relation(fields: [workOrderId], references: [id])
  partRequestId       String?
  partRequest         PartRequest?            @relation(fields: [partRequestId], references: [id])
  // Preenchido só na SAIDA gerada por aprovação de baixa (stock-withdrawals/service.ts) —
  // permite resolver, em tempo de leitura, o técnico responsável real (StockWithdrawalRequest.requestedById
  // ou Subtask.assignedToId quando a request veio de uma subtask) e o validador do encerramento da OS
  // (via StatusHistory), em vez de depender de userId para isso.
  withdrawalRequestId String?
  withdrawalRequest   StockWithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id])
  userId              String?
  user                User?                   @relation(fields: [userId], references: [id])
  reason              String?
  statusSnapshot      String?
  orderRef            String?
  createdAt           DateTime                @default(now())

  @@index([partId, createdAt])
  @@index([withdrawalRequestId])
}

model WorkOrderPlannedPart {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  partId      String
  part        Part      @relation(fields: [partId], references: [id], onDelete: Restrict)
  quantity    Int
  createdAt   DateTime  @default(now())
}

model StatusHistory {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  fromStatus  String?
  toStatus    String
  changedById String
  changedBy   User      @relation(fields: [changedById], references: [id])
  note        String?
  changedAt   DateTime  @default(now())
}

// itemType e status são String validados via zod (não enum nativo), mesma
// decisão de §2 do CLAUDE.md aplicada aos demais campos do schema.
model PartRequest {
  id              String         @id @default(cuid())
  itemType        String // "PECA" | "FERRAMENTA"
  partId          String?
  part            Part?          @relation(fields: [partId], references: [id])
  description     String
  quantity        Int
  notes           String?
  status          String         @default("PENDENTE") // PENDENTE | INCLUIDA | REJEITADA
  osId            String?
  workOrder       WorkOrder?     @relation(fields: [osId], references: [id])
  assetId         String?
  asset           Asset?         @relation(fields: [assetId], references: [id])
  criticality     Int?
  supplierName    String?
  requestedById   String
  requestedBy     User           @relation("partRequestsCreated", fields: [requestedById], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  rejectedReason  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  stockMovements StockMovement[]
}

model PurchaseOrder {
  id                    String                 @id @default(cuid())
  number                String                 @unique
  status                String                 @default("EM_ANALISE") // EM_ANALISE | APROVADO | APROVADO_PARCIAL | DEVOLVIDO | REJEITADO | ENVIADO_COMPRAS
  createdById           String
  createdBy             User                   @relation("purchaseOrdersCreated", fields: [createdById], references: [id])
  reviewedById          String?
  reviewedBy            User?                  @relation("purchaseOrdersReviewed", fields: [reviewedById], references: [id])
  reviewedAt            DateTime?
  reviewNotes           String?
  items                 PartRequest[]
  parentPurchaseOrderId String?
  parent                PurchaseOrder?         @relation("PurchaseOrderChildren", fields: [parentPurchaseOrderId], references: [id])
  children              PurchaseOrder[]        @relation("PurchaseOrderChildren")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  comments              PurchaseOrderComment[]
}

model PurchaseOrderComment {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  authorId        String
  author          User          @relation("purchaseOrderComments", fields: [authorId], references: [id])
  body            String
  supplierName    String?
  createdAt       DateTime      @default(now())
}

// Solicitação de baixa de estoque — status é String validada via zod, mesma
// decisão de §2 do CLAUDE.md. Criada sempre que uma OS é encerrada
// tecnicamente ou uma subtarefa é concluída (workorders/service.ts#encerramentoTecnico,
// subtasks/service.ts#finishSubtask), declarando peças consumidas ou
// notApplicable=true (nesse caso já nasce com status=APROVADA, pois não há
// nada para o almoxarife revisar). O débito de estoque em si (recordStockMovement)
// só acontece quando um usuário com a flag canManageStock aprova uma request
// PENDENTE — ver stock-withdrawals/service.ts.
model StockWithdrawalRequest {
  id             String                       @id @default(cuid())
  workOrderId    String
  workOrder      WorkOrder                    @relation(fields: [workOrderId], references: [id])
  subtaskId      String?
  subtask        Subtask?                     @relation(fields: [subtaskId], references: [id])
  status         String                       @default("PENDENTE") // PENDENTE | APROVADA | REJEITADA
  notApplicable  Boolean                      @default(false)
  requestedById  String
  requestedBy    User                         @relation("stockWithdrawalRequestsCreated", fields: [requestedById], references: [id])
  reviewedById   String?
  reviewedBy     User?                        @relation("stockWithdrawalRequestsReviewed", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNotes    String?
  items          StockWithdrawalRequestItem[]
  stockMovements StockMovement[]
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@index([workOrderId])
  @@index([subtaskId])
  @@index([status])
}

model StockWithdrawalRequestItem {
  id        String                 @id @default(cuid())
  requestId String
  request   StockWithdrawalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  partId    String
  part      Part                   @relation(fields: [partId], references: [id])
  quantity  Int
}

// status é String validada via zod, nunca enum nativo — mesma decisão de §2
// do CLAUDE.md aplicada aos demais campos do schema.
model PermissaoTrabalho {
  id          String    @id @default(cuid())
  workOrderId String    @unique
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  status      String    @default("RASCUNHO")

  emittedAt DateTime?
  closedAt  DateTime?

  approvedById    String?
  approvedBy      User?     @relation("PermissaoTrabalhoApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  respostas   PermissaoTrabalhoResposta[]
  assinaturas PermissaoTrabalhoAssinatura[]
}

model PermissaoTrabalhoResposta {
  id                  String            @id @default(cuid())
  permissaoTrabalhoId String
  permissaoTrabalho   PermissaoTrabalho @relation(fields: [permissaoTrabalhoId], references: [id], onDelete: Cascade)
  ordem               Int
  pergunta            String
  resposta            String?
  observacao          String?

  @@unique([permissaoTrabalhoId, ordem])
}

model PermissaoTrabalhoAssinatura {
  id                  String            @id @default(cuid())
  permissaoTrabalhoId String
  permissaoTrabalho   PermissaoTrabalho @relation(fields: [permissaoTrabalhoId], references: [id], onDelete: Cascade)
  userId              String
  user                User              @relation("PermissaoTrabalhoAssinaturaUser", fields: [userId], references: [id])
  signedAt            DateTime?
  requestedById       String
  requestedBy         User              @relation("PermissaoTrabalhoAssinaturaRequestedBy", fields: [requestedById], references: [id])
  requestedAt         DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([permissaoTrabalhoId, userId])
}
