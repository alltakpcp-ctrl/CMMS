# Porta do servidor Express
# Em produção (Render), a plataforma injeta PORT automaticamente — não fixar.
PORT=3333

# Conexão do banco — PostgreSQL em todos os ambientes (dev e produção usam Neon,
# decisão de produção no §2 do CLAUDE.md). Peça a um dev do time a connection
# string de um branch de desenvolvimento no Neon, ou crie a sua.
# Formato: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL="postgresql://user:password@ep-exemplo.neon.tech/cmms?sslmode=require"

# Segredo usado para assinar os JWTs — troque em produção por um valor forte e
# único (nunca reaproveitar o de dev). Gerar com: openssl rand -base64 48
JWT_SECRET="troque-este-segredo-em-producao"

# Tempo de expiração do access token
JWT_EXPIRES_IN="8h"

# Origem liberada para o frontend (CORS). Em produção, usar a URL do Vercel
# (ex.: https://cmms-frontend.vercel.app) — não liberar localhost em produção.
CORS_ORIGIN="http://localhost:5173"

# NODE_ENV — "development" localmente; Render define "production" automaticamente.
NODE_ENV="development"

# Postgres DEDICADO para a suíte de testes (npm test). NUNCA aponte para o
# mesmo banco do DATABASE_URL acima — os testes rodam `prisma migrate reset`,
# que APAGA todos os dados. Use um branch separado no Neon (ex.: "test").
TEST_DATABASE_URL="postgresql://user:password@ep-exemplo-test.neon.tech/cmms_test?sslmode=require"

# Kill switch do geo-fence de login. "false" desliga a checagem por completo
# (nenhuma coordenada é exigida ou validada). Ativar só depois de configurar
# as 3 chaves abaixo com o ponto-alvo correto.
GEOFENCE_ENABLED=false

# Coordenadas do ponto-alvo (ex.: portaria da fábrica), em graus decimais.
GEOFENCE_LAT=0
GEOFENCE_LNG=0

# Raio permitido a partir do ponto-alvo, em METROS.
GEOFENCE_RADIUS_M=0
